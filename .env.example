# Copy to .env and fill in. Every setting has a default, so all lines are optional.
# Full list with defaults: backend/app/config.py

# ---- API keys ----
# v1 needs no API keys: it only fetches public web pages.
# Add keys here if you add features that need them (e.g. LLM-written summaries).
# ANTHROPIC_API_KEY=

# ---- App ----
# SQLite file. In Docker this is set to sqlite:////data/llms.db (a mounted volume).
# DATABASE_URL=sqlite:///./data/llms.db
# Public URL of the deployed app, used for stable llms.txt links. Empty = use the request host.
PUBLIC_BASE_URL=
LOG_LEVEL=INFO

# ---- Crawler ----
CRAWL_MAX_PAGES=50
CRAWL_MAX_DEPTH=3
CRAWL_TIMEOUT_SECONDS=45
CRAWL_REQUEST_TIMEOUT_SECONDS=10
CRAWL_CONCURRENCY=5
CRAWL_MAX_REDIRECTS=5
# Largest response downloaded from one URL; bigger ones are skipped
CRAWL_MAX_BODY_BYTES=2000000
# How many sitemap files are fetched per crawl (including children of a sitemap index)
CRAWL_MAX_SITEMAPS=5
CRAWL_MAX_SITEMAP_URLS=5000
# Keep false in production: blocks crawling private/internal addresses.
CRAWL_ALLOW_PRIVATE_HOSTS=false

# ---- Scoring weights (docs/crawler.md) ----
SCORE_NAV=30
SCORE_SITEMAP=15
SCORE_SITEMAP_PRIORITY=10
SCORE_BODY=10
SCORE_FOOTER=5
SCORE_INBOUND=3
SCORE_KEYWORD=20
SCORE_DEPTH_PENALTY=8
SCORE_SECTION_PENALTY=5

# ---- Monitoring (docs/monitoring.md) ----
MONITOR_ENABLED=false
MONITOR_CHECK_INTERVAL_HOURS=24
MONITOR_FULL_CRAWL_TTL_DAYS=7
MONITOR_TICK_MINUTES=15
MONITOR_SITES_PER_TICK=5
MONITOR_RETRY_HOURS=6
MONITOR_MAX_RETRIES=3
